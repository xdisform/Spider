# Arsenal is downloaded at install time, never committed
/bin/
# Per-engagement workspaces (evidence, scope, findings) stay local
/targets/*
!/targets/README.md
!/targets/session.env.example
# Stray evidence dumps — must never ship with the repo
/output/
/raw/
/.output/
/.oob/
# Per-engagement runtime dumps written at the repo root (OSINT output, scan
# state, traffic logs) — regenerated per run, must never ship
/leash.jsonl
/wfpstate.xml
/harvester.json
/harvester.jsonl
/harvester.xml
*.state
# Secrets & runtime
*.env
!*.env.example
# MCP config carries API keys/instance tokens — keep the real one local, ship only the example
/.mcp.json
!/.mcp.json.example
*.log
__pycache__/
*.pyc
.mitmproxy/
# interactsh client runtime dir (regenerated by the tool; may carry local paths)
/interactsh-client/
# Ligolo runtime config carries an argon2id secret — ship only the sanitized example
/ligolo-ng.yaml
!/ligolo-ng.yaml.example
# Per-target context packs may embed real target fingerprints — never publish them.
# The sanitized _template and the README stay tracked.
/.claude/skills/context/*/
!/.claude/skills/context/_template/
