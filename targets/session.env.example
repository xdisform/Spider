# Example session.env — copy to targets/<target>/session.env when the operator supplies a foothold.
#
# SECRET. Operator-sourced ONLY (chat or material the operator obtained themselves) — never anything an
# agent observed on the target. The leash (tools/leash.py) injects SESSION_COOKIE / SESSION_HEADERS on
# every in-scope request AFTER its scope-lock, so the session rides authenticated requests automatically
# and physically cannot egress to an off-scope host. start-leash.sh sources this file if it sits next to
# leash.env. The fleet never cracks/forges/brutes a session — see .claude/commands/resume.md.
# If this repo ever becomes a git repo, session.env MUST be git-ignored.

SESSION_STATUS=supplied                         # needed | supplied | proven | revoked
SESSION_KIND=cookie                             # cookie | bearer | header | basic

# HTTP session material (what the leash injects):
SESSION_COOKIE=sid=REPLACE_ME; _csrf=REPLACE_ME # raw Cookie header value (in-scope requests only)
SESSION_HEADERS=                                # extra headers, '|'-separated, e.g. Authorization: Bearer eyJ...|X-CSRF-Token: xyz

# Provenance + semantics (non-secret; the brain reads these to build the args.session descriptor):
SESSION_PRINCIPAL=operator-acct                 # whose session — makes cross-account BOLA/IDOR meaningful
SESSION_SOURCE=operator manual login + OTP, YYYY-MM-DD
SESSION_VALID_FOR=                              # host(s) this is valid for; default = LEASH_SCOPE
PROVIDES=session:REPLACE_HOST                    # capability tokens this grants (F4 scheduler seed), comma-separated
                                                 #   e.g. session:app.example.com,creds:operator-acct@app.example.com

# Non-HTTP reuse (F3) — consumed by tools/leash-tcp.sh, NOT injected by the HTTP leash:
# SESSION_SSH_USER=operator
# SESSION_SSH_KEY=/abs/path/to/operator_key      # a key the operator is authorized to use; never a cracked one
